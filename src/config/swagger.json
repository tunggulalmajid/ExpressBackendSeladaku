{
  "openapi": "3.0.0",
  "info": {
    "title": "Seladaku IoT API Documentation",
    "version": "1.2.0",
    "description": "Dokumentasi API untuk sistem monitoring hidroponik Seladaku. Mencakup integrasi foto profil, koordinat GPS untuk cuaca, dan ID Telegram untuk notifikasi IoT."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id_user": { "type": "integer", "example": 1 },
          "nama": { "type": "string", "example": "Tunggul Majid" },
          "email": { "type": "string", "example": "tunggul@unej.ac.id" },
          "nomor_telepon": { "type": "string", "example": "08123456789" },
          "alamat": {
            "type": "string",
            "example": "Jl. Kalimantan No. 37, Jember"
          },
          "id_telegram": { "type": "string", "example": "123456789" },
          "latitude": {
            "type": "number",
            "format": "float",
            "example": -8.1724
          },
          "longitude": {
            "type": "number",
            "format": "float",
            "example": 113.7005
          },
          "foto": {
            "type": "string",
            "example": "https://res.cloudinary.com/seladaku/image/upload/v123/profile.jpg"
          }
        }
      }
    }
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Registrasi user baru",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nama", "email", "password"],
                "properties": {
                  "nama": { "type": "string", "example": "Tunggul Majid" },
                  "email": {
                    "type": "string",
                    "example": "tunggul@unej.ac.id"
                  },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Berhasil registrasi" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "tunggul@unej.ac.id"
                  },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login Berhasil (Mengembalikan accessToken & refreshToken)"
          }
        }
      }
    },
    "/api/auth/update-profile": {
      "put": {
        "tags": ["Auth"],
        "summary": "Update data profil, foto, & koordinat kebun",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "nama": { "type": "string" },
                  "email": { "type": "string" },
                  "nomorTelepon": { "type": "string" },
                  "alamat": { "type": "string" },
                  "idTelegram": {
                    "type": "string",
                    "description": "ID numerik bot Telegram"
                  },
                  "lat": { "type": "number", "format": "float" },
                  "lon": { "type": "number", "format": "float" },
                  "foto": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profil Berhasil Diperbarui",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Ambil profil user login",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Data Profil Berhasil Diambil" }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh Access Token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": { "type": "string", "description": "Refresh Token" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Access Token baru berhasil dibuat" }
        }
      }
    },
    "/api/auth/logout": {
      "delete": {
        "tags": ["Auth"],
        "summary": "Logout user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Logout Berhasil" }
        }
      }
    }
  }
}
