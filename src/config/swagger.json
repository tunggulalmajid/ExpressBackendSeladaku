{
  "openapi": "3.0.0",
  "info": {
    "title": "Seladaku IoT API Documentation",
    "version": "1.2.0",
    "description": "Dokumentasi API untuk sistem monitoring hidroponik Seladaku. Mencakup integrasi profil user, manajemen area kebun, dan koordinat GPS."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id_user": { "type": "integer", "example": 1 },
          "nama": { "type": "string", "example": "Tunggul Majid" },
          "email": { "type": "string", "example": "tunggul@unej.ac.id" },
          "nomor_telepon": { "type": "string", "example": "08123456789" },
          "alamat": {
            "type": "string",
            "example": "Jl. Kalimantan No. 37, Jember"
          },
          "id_telegram": { "type": "string", "example": "123456789" },
          "latitude": {
            "type": "number",
            "format": "float",
            "example": -8.1724
          },
          "longitude": {
            "type": "number",
            "format": "float",
            "example": 113.7005
          },
          "foto": {
            "type": "string",
            "example": "https://res.cloudinary.com/..."
          }
        }
      },
      "Area": {
        "type": "object",
        "properties": {
          "id_area": { "type": "integer", "example": 10 },
          "nama": { "type": "string", "example": "Kebun Depan" },
          "status": { "type": "boolean", "example": true },
          "total_tandon": { "type": "integer", "example": 0 },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Registrasi user baru",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nama", "email", "password"],
                "properties": {
                  "nama": { "type": "string", "example": "Tunggul Majid" },
                  "email": {
                    "type": "string",
                    "example": "tunggul@unej.ac.id"
                  },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Berhasil registrasi" } }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "tunggul@unej.ac.id"
                  },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Login Berhasil" } }
      }
    },
    "/api/auth/update-profile": {
      "put": {
        "tags": ["Auth"],
        "summary": "Update data profil & foto",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "nama": { "type": "string" },
                  "email": { "type": "string" },
                  "nomorTelepon": { "type": "string" },
                  "alamat": { "type": "string" },
                  "idTelegram": { "type": "string" },
                  "lat": { "type": "number", "format": "float" },
                  "lon": { "type": "number", "format": "float" },
                  "foto": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Profil Berhasil Diperbarui" } }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Ambil profil user login",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh Access Token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": { "token": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Token baru berhasil dibuat" } }
      }
    },
    "/api/auth/logout": {
      "delete": {
        "tags": ["Auth"],
        "summary": "Logout user",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Logout Berhasil" } }
      }
    },
    "/api/area": {
      "get": {
        "tags": ["Area"],
        "summary": "Ambil semua area milik user (Halaman Kebunku)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Daftar area berhasil diambil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Area" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Area"],
        "summary": "Tambah area/kebun baru",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nama"],
                "properties": {
                  "nama": { "type": "string", "example": "Kebun Samping" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Area Berhasil Dibuat" } }
      }
    },
    "/api/area/{id_area}": {
      "put": {
        "tags": ["Area"],
        "summary": "Update data area (Nama/Status)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id_area",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nama": {
                    "type": "string",
                    "example": "Kebun Depan Updated"
                  },
                  "status": { "type": "boolean", "example": false }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Berhasil Update" } }
      },
      "delete": {
        "tags": ["Area"],
        "summary": "Hapus area",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id_area",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": { "200": { "description": "Berhasil Hapus" } }
      }
    }
  }
}
